{
  "version": 8,
  "name": "GTA V Pause Map",
  "sources": {
    "omt": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#000000" } },
    { "id": "landuse-urban", "type": "fill", "source": "omt", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "commercial", "industrial", "retail", "railway", "suburb", "neighbourhood", "quarter", "school", "university", "hospital", "stadium"]]],
      "paint": { "fill-color": "#1d1d1d" } },
    { "id": "landcover-green", "type": "fill", "source": "omt", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "wood", "farmland", "wetland"]]],
      "paint": { "fill-color": "#788c40", "fill-opacity": 0.55 } },
    { "id": "park", "type": "fill", "source": "omt", "source-layer": "park",
      "paint": { "fill-color": "#788c40", "fill-opacity": 0.85 } },
    { "id": "landuse-green", "type": "fill", "source": "omt", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["cemetery", "pitch", "playground", "golf_course", "garden"]]],
      "paint": { "fill-color": "#788c40", "fill-opacity": 0.8 } },
    { "id": "sand", "type": "fill", "source": "omt", "source-layer": "landcover",
      "filter": ["==", ["get", "class"], "sand"], "paint": { "fill-color": "#8a8160" } },
    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water",
      "paint": { "fill-color": "#7088b0" } },
    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway",
      "paint": { "line-color": "#7088b0", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 4] } },
    { "id": "aeroway", "type": "fill", "source": "omt", "source-layer": "aeroway",
      "filter": ["==", ["geometry-type"], "Polygon"], "paint": { "fill-color": "#2a2a2a" } },
    { "id": "building", "type": "fill", "source": "omt", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#262626", "fill-outline-color": "#111111" } },

    { "id": "road-path", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["path", "track"]]], "minzoom": 14,
      "paint": { "line-color": "#4a4a4a", "line-width": 1.2, "line-dasharray": [2, 1.5] } },
    { "id": "road-service", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "service"], "minzoom": 14,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#5a5a5a", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 14, 1, 18, 6] } },
    { "id": "road-minor", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "tertiary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#777777", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 12, 0.6, 14, 2, 18, 12] } },
    { "id": "road-arterial", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["primary", "secondary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#aeaeae", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 9, 0.6, 14, 3.5, 18, 18] } },
    { "id": "road-highway", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["motorway", "trunk"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#bebebe", "line-width": ["interpolate", ["exponential", 1.5], ["zoom"], 6, 0.8, 14, 5, 18, 24] } },
    { "id": "rail", "type": "line", "source": "omt", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "rail"], "minzoom": 12,
      "paint": { "line-color": "#3a3a3a", "line-width": 1.5 } },

    { "id": "place-district", "type": "symbol", "source": "omt", "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["suburb", "neighbourhood", "quarter"]]], "minzoom": 12,
      "layout": { "text-field": ["upcase", ["get", "name"]], "text-font": ["Noto Sans Bold"], "text-size": 12,
                  "text-letter-spacing": 0.15, "text-max-width": 8 },
      "paint": { "text-color": "#d8d8d8", "text-halo-color": "#000000", "text-halo-width": 1.5, "text-opacity": 0.8 } },
    { "id": "place-city", "type": "symbol", "source": "omt", "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "village"]]],
      "layout": { "text-field": ["upcase", ["get", "name"]], "text-font": ["Noto Sans Bold"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 8, 12, 14, 18], "text-letter-spacing": 0.2 },
      "paint": { "text-color": "#ffffff", "text-halo-color": "#000000", "text-halo-width": 2 } }
  ]
}
