{
 "version": 8,
 "name": "GTA V Atlas",
 "sources": {
  "omt": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet"
  },
  "dem": {
   "type": "raster-dem",
   "tiles": [
    "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png"
   ],
   "encoding": "terrarium",
   "tileSize": 256,
   "maxzoom": 14,
   "attribution": "Terrain: Mapzen / AWS Terrain Tiles"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#e4d9b4"
   }
  },
  {
   "id": "landuse-urban",
   "type": "fill",
   "source": "omt",
   "source-layer": "landuse",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "residential",
      "commercial",
      "industrial",
      "retail",
      "railway",
      "suburb",
      "neighbourhood",
      "quarter",
      "school",
      "university",
      "hospital",
      "stadium"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#ebe2c2"
   }
  },
  {
   "id": "landcover-green",
   "type": "fill",
   "source": "omt",
   "source-layer": "landcover",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "grass",
      "wood",
      "farmland",
      "wetland"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#9cbf7a"
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "omt",
   "source-layer": "park",
   "paint": {
    "fill-color": "#8fb56c"
   }
  },
  {
   "id": "landuse-green",
   "type": "fill",
   "source": "omt",
   "source-layer": "landuse",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "cemetery",
      "pitch",
      "playground",
      "golf_course",
      "garden"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#8fb56c"
   }
  },
  {
   "id": "sand",
   "type": "fill",
   "source": "omt",
   "source-layer": "landcover",
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "sand"
   ],
   "paint": {
    "fill-color": "#efdca0"
   }
  },
  {
   "id": "hillshade",
   "type": "hillshade",
   "source": "dem",
   "paint": {
    "hillshade-exaggeration": 0.7,
    "hillshade-shadow-color": "#5c4a2a",
    "hillshade-highlight-color": "#fff6dc",
    "hillshade-accent-color": "#6e5a36",
    "hillshade-illumination-direction": 315
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "omt",
   "source-layer": "water",
   "paint": {
    "fill-color": "#7fb6d3"
   }
  },
  {
   "id": "waterway",
   "type": "line",
   "source": "omt",
   "source-layer": "waterway",
   "paint": {
    "line-color": "#7fb6d3",
    "line-width": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     10,
     1,
     16,
     4
    ]
   }
  },
  {
   "id": "aeroway",
   "type": "fill",
   "source": "omt",
   "source-layer": "aeroway",
   "filter": [
    "==",
    [
     "geometry-type"
    ],
    "Polygon"
   ],
   "paint": {
    "fill-color": "#d8ccaa"
   }
  },
  {
   "id": "building",
   "type": "fill",
   "source": "omt",
   "source-layer": "building",
   "minzoom": 14,
   "paint": {
    "fill-color": "#d6cba6",
    "fill-outline-color": "#c2b48c"
   }
  },
  {
   "id": "road-path",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "path",
      "track"
     ]
    ]
   ],
   "minzoom": 14,
   "paint": {
    "line-color": "#c9b98c",
    "line-width": 1.2,
    "line-dasharray": [
     2,
     1.5
    ]
   }
  },
  {
   "id": "road-service",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "service"
   ],
   "minzoom": 14,
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#fbf6e6",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     14,
     1,
     18,
     6
    ]
   }
  },
  {
   "id": "road-minor",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "minor",
      "tertiary"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#ffffff",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     12,
     0.6,
     14,
     2,
     18,
     12
    ]
   }
  },
  {
   "id": "road-arterial",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "primary",
      "secondary"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#f4c95a",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     9,
     0.6,
     14,
     3.5,
     18,
     18
    ]
   }
  },
  {
   "id": "road-highway",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "motorway",
      "trunk"
     ]
    ]
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#ea9a2d",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.5
     ],
     [
      "zoom"
     ],
     6,
     0.8,
     14,
     5,
     18,
     24
    ]
   }
  },
  {
   "id": "rail",
   "type": "line",
   "source": "omt",
   "source-layer": "transportation",
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "rail"
   ],
   "minzoom": 12,
   "paint": {
    "line-color": "#9a8c70",
    "line-width": 1.5
   }
  },
  {
   "id": "place-district",
   "type": "symbol",
   "source": "omt",
   "source-layer": "place",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "suburb",
      "neighbourhood",
      "quarter"
     ]
    ]
   ],
   "minzoom": 12,
   "layout": {
    "text-field": [
     "upcase",
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": 12,
    "text-letter-spacing": 0.15,
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#3b3020",
    "text-halo-color": "#f4ecd2",
    "text-halo-width": 1.5,
    "text-opacity": 0.8
   }
  },
  {
   "id": "place-city",
   "type": "symbol",
   "source": "omt",
   "source-layer": "place",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "city",
      "town",
      "village"
     ]
    ]
   ],
   "layout": {
    "text-field": [
     "upcase",
     [
      "get",
      "name"
     ]
    ],
    "text-font": [
     "Noto Sans Bold"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     8,
     12,
     14,
     18
    ],
    "text-letter-spacing": 0.2
   },
   "paint": {
    "text-color": "#3b3020",
    "text-halo-color": "#f4ecd2",
    "text-halo-width": 2
   }
  }
 ]
}